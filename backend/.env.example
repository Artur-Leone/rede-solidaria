# Porta do Servidor (Render injeta a porta dinamicamente na variável PORT)
PORT=3001

# Ambiente de Execução
NODE_ENV=development

# Origem permitida para requisições do Frontend (Vercel ou Localhost)
CORS_ORIGIN=http://localhost:5173

# Chave de API de IA (Opcional - o AIService usa fallback simulado se não informada)
GEMINI_API_KEY=

# Banco de Dados PostgreSQL (Opcional no primeiro deploy - app possui fallback em memória)
DATABASE_URL=postgresql://usuario:senha@localhost:5432/sombrinha?schema=public
